# 系统编码
VITE_APP_SYSCODE = '/funds'

# 页面标题
VITE_APP_TITLE = 资金管理系统

# 生产环境配置
VITE_APP_ENV = 'production'

# SPD管理系统/生产环境   不需要配置前缀，nginx实现了代理
VITE_APP_BASE_API = '/api/funds'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip,brotli
VITE_APP_TIME='build time'

# ureprot地址
VITE_APP_UREPORT_URL = '/basic'

VITE_APP_IFREAME = '/api'

#office api地址
VITE_APP_DOCUMENTAPI = '/web-apps/apps/api/documents/api.js'

#图片文件配置回显地址
VITE_APP_FILE_URL = '/minioServer'

# 开发环境
VITE_HOST_URL = '/'

VITE_APP_BASIC_API= '/basic'
